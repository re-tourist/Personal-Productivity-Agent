# Copy to .env, never commit the real key
DASHSCOPE_API_KEY=
# Use your workspace/region endpoint if applicable.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PPA_MODEL=qwen3.7-flash
PPA_ENABLE_LIVE_QWEN=0
# Optional local demo token. It is not user/tenant authorization.
PPA_API_TOKEN=
PPA_DATA_DIR=.ppa-data
# Optional secure local test accounts. Generate private files first; blank keeps legacy mode.
PPA_AUTH_CONFIG=
